# 复制为 .env 后填写（.env 已 gitignore，不要提交）
# 可与 config.json 叠加；同名项环境变量优先。

# BAIDU_COOKIE=BDUSS=...; STOKEN=...
# ACCESS_TOKEN=
# 会话签名密钥；留空则由 ACCESS_TOKEN 派生。改这个值可一键强制所有人重新登录。
# SESSION_SECRET=
# 登录会话有效期（秒），默认 7 天（604800）。
# AUTH_SESSION_TTL_SECONDS=604800
# FORCE_SECURE_COOKIE=true
# PORT=4172
# BIND_ADDRESS=0.0.0.0
# 仅填写实际反代服务器的 IP/CIDR；为空时完全不信任 X-Forwarded-For
# TRUSTED_PROXY_IPS=127.0.0.1,::1,10.0.0.0/8
# 启用 JSONL 下载审计；目录需提前创建并确保进程可写
# AUDIT_LOG_PATH=./data/download-audit.jsonl
# 共享目录白名单，多个路径用英文逗号分隔；为空时不限制
# ALLOWED_PATHS=/共享资料,/临时中转
# TZ=Asia/Shanghai
